<?xml version="1.0" encoding="UTF-8"?>

<project name="Docviewer" default="build" basedir=".">
    <property name="build-release" value="25" />
    <path id="project.classpath">
        <pathelement path="${play.path}/framework/classes"/>
        <fileset dir="${play.path}/framework/lib">
            <include name="*.jar"/>
        </fileset>
    </path>

    <target name="build" depends="compile">

        <copy todir="tmp/classes">
            <fileset dir="src">
                <include name="**/*.properties"/>
                <include name="**/*.xml"/>
                <include name="**/play.plugins"/>
                <include name="**/play.static"/>
            </fileset>
        </copy>
        <jar destfile="lib/play-docviewer.jar" basedir="tmp/classes">
            <manifest>
                <section name="Play">
                    <attribute name="Specification-Title" value="Docviewer"/>
                </section>
            </manifest>
        </jar>
        <delete dir="tmp" />
    </target>

    <target name="compile">
        <mkdir dir="tmp/classes" />
        <javac srcdir="src" destdir="tmp/classes" debug="true" release="${build-release}" includeantruntime="false">
            <classpath refid="project.classpath" />
        </javac>
    </target>

    <!-- PF-164: runs docviewer's JUnit tests; invoked by the framework's `module-unittest`.
         Scope is src/ only — that is all this build compiles. app/ (controllers, helpers,
         DocViewerPlugin) is compiled at runtime by ApplicationClassloader when the module is
         mounted, so it is unreachable from a JUnit sourceset; /@docs routing is covered by the
         framework's integration.DocViewerFunctionalTest instead, which mounts docviewer into
         the integration fixture. See PF-163 for the bug that split was introduced to catch. -->
    <target name="unittest" depends="build">
        <mkdir dir="tmp/test-classes" />
        <javac srcdir="test" destdir="tmp/test-classes" debug="true" release="${build-release}" includeantruntime="false">
            <classpath>
                <path refid="project.classpath" />
                <fileset dir="lib" includes="*.jar" />
            </classpath>
        </javac>
        <junitlauncher haltonfailure="true" printSummary="true">
            <testclasses>
                <fileset dir="tmp/test-classes" includes="**/*Test.class" />
                <fork />
            </testclasses>
            <classpath>
                <pathelement location="tmp/test-classes" />
                <path refid="project.classpath" />
                <fileset dir="lib" includes="*.jar" />
            </classpath>
        </junitlauncher>
        <delete dir="tmp" />
    </target>

</project>
