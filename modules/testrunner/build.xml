<?xml version="1.0" encoding="UTF-8"?>

<project name="testrunner module" default="build" basedir=".">
    <!-- PF-260: a test JVM that ends before its run does fails the build (see the file). -->
    <import file="../../framework/run-completion.xml" />

    <property name="build-release" value="25" />
    <path id="project.classpath">
        <pathelement path="../../framework/classes"/>
        <fileset dir="../../framework/lib">
            <include name="*.jar"/>
        </fileset>
        <fileset dir="firephoque">
            <include name="*.jar"/>
        </fileset>
    </path>

    <target name="build">
        <mkdir dir="tmp/classes" />
        <mkdir dir="lib" />
        <javac srcdir="src" destdir="tmp/classes" release="${build-release}" includeantruntime="false">
            <classpath refid="project.classpath" />
        </javac>
        <copy todir="tmp/classes">
            <fileset dir="src">
                <include name="**/*.properties"/>
                <include name="**/*.xml"/>
                <include name="**/play.plugins"/>
            </fileset>
        </copy>
        <jar destfile="lib/play-testrunner.jar" basedir="tmp/classes">
            <manifest>
                <section name="Play">
                    <attribute name="Specification-Title" value="Test runner module"/>
                </section>
            </manifest>
        </jar>
        <delete dir="tmp" />
    </target>

    <!-- PF-217: runs testrunner's JUnit tests; invoked by the framework's `module-unittest`.
         app/ is compiled at runtime by ApplicationClassloader when the module is mounted, so no
         sourceset reaches it. The /@tests.list classifier, app/testrunner/, depends on nothing
         but the framework and ASM, so this target compiles it beside its tests; the controllers
         stay untested here. The framework alone is the classpath: firephoque/ holds other
         versions of some of its jars. -->
    <path id="unittest.classpath">
        <pathelement path="../../framework/classes"/>
        <fileset dir="../../framework/lib">
            <include name="*.jar"/>
        </fileset>
    </path>

    <target name="unittest">
        <mkdir dir="tmp/test-classes" />
        <javac destdir="tmp/test-classes" debug="true" release="${build-release}" includeantruntime="false">
            <src path="app" />
            <src path="test" />
            <include name="testrunner/**" />
            <classpath refid="unittest.classpath" />
        </javac>
        <fileset id="tests.unit" dir="tmp/test-classes" includes="**/*Test.class" />
        <run-completion-start file="${basedir}/tmp/.run-unittest" />
        <junitlauncher haltonfailure="true" printSummary="true">
            <testclasses>
                <fileset refid="tests.unit" />
                <fork>
                    <sysproperty key="play.tests.completion" value="${basedir}/tmp/.run-unittest" />
                </fork>
            </testclasses>
            <classpath>
                <pathelement location="tmp/test-classes" />
                <!-- PF-260: the run-completion listener, which framework's compile-tests copies there -->
                <pathelement location="../../framework/test-support" />
                <path refid="unittest.classpath" />
            </classpath>
        </junitlauncher>
        <run-completion-check file="${basedir}/tmp/.run-unittest" label="testrunner unittest"
                              testclasses="../../framework/test-support" root="${basedir}/tmp/test-classes">
            <selected><fileset refid="tests.unit" /></selected>
        </run-completion-check>
        <delete dir="tmp" />
    </target>

</project>
