{
  // Renovate configuration for the Play 1.13 fork.
  // Schema: https://docs.renovatebot.com/renovate-schema.json
  //
  // Renovate is the sole dependency-update bot for this repo. It covers:
  //   - GitHub Actions in .github/workflows/*.yml (auto-detected)
  //   - npm in resources/nuxt-skel/package.json (auto-detected). This is the
  //     skeleton shipped to new apps via `gradle playNewApp -Pfrontend` —
  //     keeping it current means fresh scaffolds get a recent Nuxt baseline.
  //   - Java/Ivy in framework/dependencies.yml (custom regex manager below)
  //
  // .github/dependabot.yml was retired when this config was introduced —
  // running both bots produced overlapping Actions PRs.
  //
  // Java dependency workflow (important):
  // Renovate edits framework/dependencies.yml in place but cannot run
  // `ant resolve` — that step downloads the new jar and prunes the old
  // one in framework/lib/. Renovate PRs for Java deps therefore arrive
  // INCOMPLETE: the YAML is bumped but the lib/ jars are stale.
  //
  // To finish a Java-dep PR locally:
  //   gh pr checkout <number>
  //   cd framework
  //   ant resolve -Dprune=true   # downloads new jar + removes the old
  //   git add framework/lib framework/dependencies.yml
  //   git commit -m "ant resolve"
  //   git push
  //
  // Then merge as usual. Some PRs (Netty, Micrometer, Hibernate) carry
  // multiple jars and may need transitive deps to be added by hand —
  // see the dependencies.yml header comments for examples.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    "group:allNonMajor",
    ":timezone(Asia/Singapore)"
  ],

  // Off-hours scheduling. Bound PR noise without delaying urgent CVE bumps.
  // Split into separate entries rather than the compound
  // "after 10pm and before 5am every weekday" — Renovate migrates that form
  // to exactly this. Entries are OR'd, so the window is 22:00-24:00 and
  // 00:00-05:00 on weekdays, plus all weekend.
  schedule: [
    "after 10pm every weekday",
    "before 5am every weekday",
    "every weekend"
  ],

  // REQUIRED: tsukhani/play1 is a fork of playframework/play1, and Renovate
  // skips forks by default — including forks that have a config file, because
  // it can't tell whether the file came from upstream. Mend only flips this on
  // automatically when the app is installed with "Selected repositories"; an
  // "All repositories" install leaves it disabled and this repo is silently
  // never processed. Setting it explicitly makes activation independent of how
  // the app happens to be installed.
  forkProcessing: "enabled",

  // Single dashboard issue summarises every pending update — easier to
  // review than scrolling the PR list.
  dependencyDashboard: true,
  dependencyDashboardTitle: "Renovate dependency dashboard",

  // Custom regex manager for the Play 1 Ivy manifest.
  // dependencies.yml lines look like:
  //   - io.swagger.core.v3 -> swagger-models 2.2.39
  //   - org.apache.logging.log4j -> log4j-core 2.25.3
  // The few legacy short-form deps without a "->" (e.g. "antlr4-runtime
  // 4.13.0", "commons-beanutils 1.11.0") aren't matched — those use Ivy
  // shorthand where group=artifact and don't map cleanly to Maven Central
  // group IDs. Track those manually if they need bumping.
  customManagers: [
    {
      customType: "regex",
      // Renamed from `fileMatch` in Renovate 40. A regex (rather than a glob)
      // has to be wrapped in slashes here.
      managerFilePatterns: ["/^framework/dependencies\\.yml$/"],
      matchStrings: [
        "-\\s+(?<groupId>[a-zA-Z0-9_.\\-]+)\\s+->\\s+(?<artifactId>[a-zA-Z0-9_.\\-]+)\\s+(?<currentValue>[0-9][\\w.\\-]+)"
      ],
      datasourceTemplate: "maven",
      depNameTemplate: "{{{groupId}}}:{{{artifactId}}}"
    }
  ],

  packageRules: [
    // Group multi-artifact families so one PR bumps the whole set in
    // lockstep. Saves merge churn AND avoids version-skew CVEs that
    // happen when (e.g.) netty-codec-http and netty-handler diverge.
    {
      matchPackageNames: ["io.netty:**"],
      groupName: "Netty"
    },
    {
      matchPackageNames: ["io.micrometer:**"],
      groupName: "Micrometer"
    },
    {
      matchPackageNames: ["io.swagger.core.v3:**"],
      groupName: "Swagger / OpenAPI"
    },
    {
      matchPackageNames: ["com.fasterxml.jackson**"],
      groupName: "Jackson"
    },
    {
      matchPackageNames: [
        "org.hibernate.orm:**",
        "org.hibernate.models:**",
        "org.hibernate.validator:**"
      ],
      groupName: "Hibernate"
    },
    {
      matchPackageNames: ["org.apache.logging.log4j:**"],
      groupName: "Log4j"
    },
    {
      matchPackageNames: ["io.prometheus:**"],
      groupName: "Prometheus client_java"
    },
    {
      matchPackageNames: ["org.junit.**"],
      groupName: "JUnit"
    },
    {
      matchPackageNames: ["org.bouncycastle:**"],
      groupName: "Bouncy Castle"
    },
    {
      matchPackageNames: ["jakarta.**"],
      groupName: "Jakarta APIs"
    },
    {
      matchPackageNames: ["org.eclipse.jdt:**"],
      groupName: "Eclipse JDT"
    },
    {
      matchPackageNames: ["com.aayushatharva.brotli4j:**"],
      groupName: "brotli4j (multi-platform native)"
    },
    {
      matchPackageNames: ["org.codehaus.groovy:**"],
      groupName: "Groovy"
    },
    {
      // Byte Buddy publishes a parallel `-jdk5` line (built for Java 5
      // bytecode) alongside every normal release: 1.18.11 and 1.18.11-jdk5
      // both exist. The suffixed one sorts LAST, so Maven Central's own
      // <latest>/<release> metadata points at it and Renovate offers
      // 1.18.10 -> 1.18.11-jdk5 as a routine patch bump. That is not an
      // upgrade — it swaps the artifact for one targeting a bytecode level
      // 20 majors below the Java 25 this framework requires, and nothing in
      // CI would flag it. Caught once during a merge; pinned so it can't
      // recur.
      matchPackageNames: ["net.bytebuddy:**"],
      allowedVersions: "!/-jdk5$/"
    },
    {
      // Major bumps go through manual review — never auto-merge.
      matchUpdateTypes: ["major"],
      automerge: false,
      labels: ["dependencies", "major-bump"],
      addLabels: ["needs-review"]
    },
    {
      // Patch + minor: label them for the dashboard but don't auto-merge.
      // The user runs `ant resolve` locally to complete each PR; that step
      // also serves as a human review checkpoint, so blanket auto-merge
      // wouldn't save effort here.
      matchUpdateTypes: ["minor", "patch"],
      automerge: false,
      labels: ["dependencies"]
    },
    {
      // npm deps in nuxt-skel/package.json: Renovate handles end-to-end (no
      // manual step needed). Auto-merge non-major bumps is acceptable here
      // because the blast radius is scaffold-only — already-scaffolded apps
      // pin their own resolved versions in pnpm-lock.yaml and aren't
      // affected by a skel bump. Worst case is a fresh `playNewApp -Pfrontend`
      // resolves a regressed Nuxt patch; user fixes in their own app's lockfile.
      // (CI doesn't run pnpm install on the skel, so no test gates this path.)
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "branch",
      labels: ["dependencies", "frontend"]
    },
    {
      // GitHub Actions: pin third-party actions to a commit digest so a
      // hostile owner can't retag a release tag and silently swap in
      // malicious code (recurring supply-chain incident pattern). The
      // pin is on the digest; Renovate updates the digest plus a
      // human-readable comment with the version number.
      matchManagers: ["github-actions"],
      pinDigests: true,
      labels: ["dependencies", "ci"]
    }
  ],

  // Be polite: cap concurrent PRs so the queue doesn't get swamped on
  // a busy week.
  prConcurrentLimit: 5,
  prHourlyLimit: 2
}
