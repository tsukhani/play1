#!/bin/sh
# Play 1 — thin wrapper around Gradle.
#
# This script lives at the root of the play1 framework distribution. Add this
# directory to your PATH so you can run `play <command>` from anywhere.
#
# `play new <name>` runs the framework's gradlew (since playNewApp is registered
# only in the framework's build.gradle.kts). All other commands run the local
# ./gradlew from the current working directory (the application's gradlew).

set -e

# --- Resolve PLAY_HOME from this script's location, following symlinks ----
SCRIPT="$0"
while [ -h "$SCRIPT" ]; do
    LINK=$(readlink "$SCRIPT")
    case "$LINK" in
        /*) SCRIPT="$LINK" ;;
        *)  SCRIPT="$(dirname "$SCRIPT")/$LINK" ;;
    esac
done
PLAY_HOME="$(cd "$(dirname "$SCRIPT")" && pwd)"

# --- Banner ---------------------------------------------------------------
# Mirrors the logo printed by the pre-1.13 Python CLI. Suppressed by --silent.
print_logo() {
    cat <<'EOF'
~  _   _       _ _       _     _
~ | | | |_   _| | | __ _| |__ | |
~ | |_| | | | | | |/ _' | '_ \| |
~ |  _  | |_| | | | (_| | | | |_|
~ |_| |_|\__,_|_|_|\__,_|_| |_(_)
~
EOF
    if [ -f "$PLAY_HOME/framework/src/play/version" ]; then
        VERSION=$(cat "$PLAY_HOME/framework/src/play/version")
        printf '~ play! %s, https://www.playframework.com\n~\n' "$VERSION"
    fi
}

# --- Help / usage ---------------------------------------------------------
print_usage() {
    cat <<'EOF'
Play 1 — Gradle-backed CLI wrapper.

Usage: play <command> [args...]

Application lifecycle:
  run                  Run the application in the foreground (dev mode)
  start                Start the application in the background
  stop                 Stop the running application
  restart              Restart the running application
  status               Print application status
  pid                  Print the running application's PID
  out                  Tail the running application's log
                       The above background commands accept --pid-file=<name>
                       to target a specific instance (default: server.pid;
                       fallback: application.pidFile in conf/application.conf).

Build / test / package:
  clean                Remove generated files
  precompile           Precompile sources and templates for production
  test                 Run the application's tests interactively
  autotest             Run tests headlessly and exit
                       (--tests=Class,... runs only the named test classes)
  dist                 Package the source tree as <rootProject.name>.zip
                       (respects .gitignore and .distignore)
  bundle               Build a self-contained deployment zip
                       (precompiled classes + framework + deps + bin/start.sh)

Project setup:
  new <name>           Scaffold a new application in <cwd>/<name>
                       Optional: --frontend (Nuxt 3 frontend)
                                 --dest=<path> (override destination directory)
  secret               Generate a new application secret

Nuxt frontend (apps scaffolded with --frontend):
  The frontend is a separate process — `cd frontend && pnpm dev` (port 3000) —
  which proxies /api/** to the backend. It resolves the backend port as:
    1. PLAY_BACKEND_PORT=<port> pnpm dev
                       Use this alongside `play run --http.port=<port>`. A CLI
                       port override never touches conf/application.conf, so the
                       frontend has no other way to learn about it.
    2. http.port=<port> in conf/application.conf
                       Set it there instead and both halves agree on their own,
                       with no env var and no flag on either command.
    3. 9000            Play's default, when neither of the above is set.

Information:
  classpath            Print the resolved runtime classpath
  modules              List installed modules
  evolutions           Apply database evolutions
  javadoc              Generate Javadoc for the application
                       Optional: --include-modules (include declared module sources)
                                 --links (add external API doc links)
  version              Print the framework version
  help                 Show this help

Argument forwarding:
  --key=value          Pass a property override to the build
  --key                Pass a boolean property flag
EOF
}

# --- Subcommand → Gradle task lookup --------------------------------------
task_for() {
    case "$1" in
        run)             echo playRun ;;
        start)           echo playStart ;;
        stop)            echo playStop ;;
        restart)         echo playRestart ;;
        status)          echo playStatus ;;
        pid)             echo playPid ;;
        out)             echo playOut ;;
        test)            echo playTest ;;
        autotest)        echo playAutotest ;;
        clean)           echo playClean ;;
        precompile)      echo playPrecompile ;;
        evolutions)      echo playEvolutions ;;
        classpath)       echo playClasspath ;;
        modules)         echo playModulesInfo ;;
        secret)          echo playSecret ;;
        javadoc)         echo playJavadoc ;;
        dist)            echo playDist ;;
        bundle)          echo playBundle ;;
        version)         echo playVersion ;;
        *)               return 1 ;;
    esac
}

# --- Locate a gradlew/gradle to invoke ------------------------------------
# Order: ./gradlew (CWD) → $PLAY_HOME/gradlew (when in framework dir) →
# system `gradle` on PATH → install-instructions error.
find_gradle() {
    if [ -x "./gradlew" ]; then
        echo "./gradlew"
        return 0
    fi
    if [ "$PWD" = "$PLAY_HOME" ] && [ -x "$PLAY_HOME/gradlew" ]; then
        echo "$PLAY_HOME/gradlew"
        return 0
    fi
    if command -v gradle >/dev/null 2>&1; then
        echo "gradle"
        return 0
    fi
    cat >&2 <<EOF
play: no Gradle wrapper found in this directory and 'gradle' is not on PATH.

Most play commands run from inside an application directory (one containing a
./gradlew script). Either:
  - cd into your Play 1 application, or
  - run \`play new <name>\` to scaffold a new one.

If you intend to run Gradle directly without a wrapper, install Gradle:
  macOS:    brew install gradle
  Linux:    sdk install gradle             (or your distro's package manager)
  Windows:  winget install Gradle.Gradle
  Manual:   https://gradle.org/install/
EOF
    return 1
}

# --- Forward CLI flags as Gradle -P properties ----------------------------
# Translates 1.12 Python-CLI argument shapes into the Gradle wire format
# the plugin understands. Outputs one arg per line; the caller reads with
# IFS=newline + `set --` to preserve spaces in -PjvmArgs values.
#
#   --info, --debug, --stacktrace, ...   →   pass through (Gradle's own flags)
#   --%<id>                              →   -PplayId=<id>          (1.12 mode prefix)
#   --http.port=X                        →   -PhttpPort=X           (camelCase plugin prop)
#   --https.port=X                       →   -PhttpsPort=X          (same)
#   -Xms..., -Xmx..., -XX:..., -D...,    →   accumulated into a single
#   -Xlog:..., -javaagent:..., -agentlib:    -PjvmArgs="..." line emitted at end
#   --foo=bar, --foo                     →   -Pfoo=bar / -Pfoo      (generic)
#   anything else                        →   pass through unchanged
forward_args() {
    JVM_ARGS=""
    for arg in "$@"; do
        case "$arg" in
            --info|--debug|--warn|--quiet|--stacktrace|--scan|--no-daemon|--no-build-cache|--no-configuration-cache|--rerun-tasks|--refresh-dependencies|--offline|--continue|--dry-run)
                printf '%s\n' "$arg" ;;
            --%*)
                printf '%s\n' "-PplayId=${arg#--%}" ;;
            --http.port=*)
                printf '%s\n' "-PhttpPort=${arg#--http.port=}" ;;
            --https.port=*)
                printf '%s\n' "-PhttpsPort=${arg#--https.port=}" ;;
            -X*|-D*|-XX:*|-Xlog:*|-javaagent:*|-agentlib:*)
                JVM_ARGS="${JVM_ARGS:+$JVM_ARGS }$arg" ;;
            --*=*)
                printf '%s\n' "-P${arg#--}" ;;
            --*)
                printf '%s\n' "-P${arg#--}" ;;
            *)
                printf '%s\n' "$arg" ;;
        esac
    done
    [ -n "$JVM_ARGS" ] && printf '%s\n' "-PjvmArgs=$JVM_ARGS"
    # Always return 0 — the trailing `&&` above sets $? to 1 when JVM_ARGS is
    # empty, and with `set -e` that propagates out through `TRANSLATED=$(...)`
    # and kills the wrapper before exec'ing Gradle. Empty-JVM_ARGS is the
    # common case; this is not an error.
    return 0
}

# --- Strip --silent from args (controls banner only; never reaches Gradle) -
SILENT=0
NARGS=$#
i=0
while [ $i -lt $NARGS ]; do
    arg="$1"
    shift
    if [ "$arg" = "--silent" ]; then
        SILENT=1
    else
        set -- "$@" "$arg"
    fi
    i=$((i + 1))
done
[ "$SILENT" -eq 0 ] && print_logo

# --- Dispatch -------------------------------------------------------------
CMD="${1:-help}"
[ $# -gt 0 ] && shift

case "$CMD" in
    help|--help|-h|"")
        print_usage
        exit 0
        ;;
    version)
        # Handle directly so `play version` works from any cwd, including
        # locations without a Gradle wrapper. The banner already reads this
        # file; print the bare version too for scripting (parse with cut).
        if [ -f "$PLAY_HOME/framework/src/play/version" ]; then
            cat "$PLAY_HOME/framework/src/play/version"
        else
            echo "play: framework version file not found at $PLAY_HOME/framework/src/play/version" >&2
            exit 1
        fi
        exit 0
        ;;
    new)
        # A flag in the name position (`play new --frontend`) means the name was
        # omitted, not that the app is called "--frontend". Reject anything
        # starting with `-` here: the option loop below only runs after the name
        # has been consumed, so without this the flag is taken as the name and we
        # cheerfully scaffold a directory called "--frontend".
        case "${1:-}" in
            '' | -*)
                echo "play new: missing application name." >&2
                echo "Usage: play new <name> [--frontend] [--dest=<path>]" >&2
                exit 1
                ;;
        esac
        APP_NAME="$1"
        shift
        # Default destination: $PWD/$APP_NAME (the user's current working dir).
        # --dest=<path> overrides this. The user's CWD is captured *before* we
        # cd to PLAY_HOME so relative dest paths resolve correctly.
        ORIG_CWD="$PWD"
        DEST="$ORIG_CWD/$APP_NAME"
        EXTRA=""
        for arg in "$@"; do
            case "$arg" in
                --frontend)   EXTRA="$EXTRA -Pfrontend" ;;
                --dest=*)     DEST="${arg#--dest=}" ;;
                --*=*)        EXTRA="$EXTRA -P${arg#--}" ;;
                --*)          EXTRA="$EXTRA -P${arg#--}" ;;
                *)            echo "play new: unrecognized argument '$arg'" >&2; exit 1 ;;
            esac
        done
        # Resolve DEST to absolute path so it doesn't depend on PLAY_HOME
        case "$DEST" in
            /*) ;;
            *)  DEST="$ORIG_CWD/$DEST" ;;
        esac
        # PLAY_HOME may be a read-only system install (e.g. /opt/play1 owned by
        # root) where the invoking user can't write. Gradle 9 refuses to run
        # against a read-only project directory regardless of --project-cache-dir,
        # so we stage a scratch project that *symlinks* the framework's build
        # files into a writable temp dir, then run Gradle from there. The task
        # itself reads from the symlinked source paths (read OK on a read-only
        # install) and writes scaffolded output under -Pdest (already on a
        # writable user path); only Gradle's own .gradle/ + build/ land in the
        # scratch dir, which we clean up on exit.
        SCRATCH=$(mktemp -d "${TMPDIR:-/tmp}/play-new.XXXXXX")
        # Restore write bits before rm-rf — cp -R below preserves source modes,
        # so files copied from a read-only install are read-only and rm refuses
        # to unlink them on macOS without prior chmod.
        trap 'chmod -R u+w "$SCRATCH" 2>/dev/null; rm -rf "$SCRATCH"' EXIT INT TERM HUP
        # Symlink the heavy stuff (framework/, resources/) and the build script
        # itself. gradle/ is small (~50KB) and has to be a real directory because
        # PlayNewAppTask runs `fileSystemOps.copy { include("gradle/wrapper/**") }`,
        # which doesn't traverse symlinked source directories the way include()
        # globs expect.
        for entry in build.gradle.kts gradlew framework resources; do
            if [ -e "$PLAY_HOME/$entry" ]; then
                ln -s "$PLAY_HOME/$entry" "$SCRATCH/$entry"
            fi
        done
        cp -R "$PLAY_HOME/gradle" "$SCRATCH/gradle"
        # Minimal settings file: deliberately omit `include(":gradle-plugin")`
        # because playNewApp doesn't need the plugin subproject configured, and
        # configuring it would force its own build dir to be writable too.
        printf 'rootProject.name = "play1-scaffold"\n' > "$SCRATCH/settings.gradle.kts"
        cd "$SCRATCH"
        # -PframeworkPath pins the *real* framework location into the generated
        # app's build.gradle.kts (instead of leaking the scratch dir, which we're
        # about to delete).
        # shellcheck disable=SC2086  # word-splitting EXTRA is intentional
        ./gradlew playNewApp -PframeworkPath="$PLAY_HOME" -Pname="$APP_NAME" -Pdest="$DEST" $EXTRA
        ;;
    deps|check|ant|install|list-modules|build-module|new-module|id)
        cat >&2 <<EOF
play $CMD: removed in 1.13.x.

Gradle handles dependency resolution and build orchestration natively. There is
no longer a lib/ directory or modules registry to manage.

  - To inspect dependencies:  ./gradlew dependencies
  - To add a dependency:      edit build.gradle.kts
  - To list bundled modules:  play modules
EOF
        exit 1
        ;;
    idea|intellij|eclipse|netbeans)
        cat >&2 <<EOF
play $CMD: not needed in 1.13.x.

Open your IDE (IntelliJ IDEA, VS Code with the Gradle extension, Eclipse with
Buildship, etc.) and point it at build.gradle.kts in your application directory.
Modern IDEs auto-import Gradle projects without generated project files.
EOF
        exit 0
        ;;
    *)
        if TASK=$(task_for "$CMD"); then
            GRADLEW=$(find_gradle) || exit 1
            # Read forward_args output line-by-line into positional params so
            # the -PjvmArgs="-Xms... -Xmx... ..." accumulator (which contains
            # spaces) survives intact through to gradle. Capture before
            # `set --` so $@ is still the original args when forward_args runs.
            TRANSLATED=$(forward_args "$@")
            set --
            while IFS= read -r line; do
                [ -n "$line" ] && set -- "$@" "$line"
            done <<EOF
$TRANSLATED
EOF
            exec "$GRADLEW" "$TASK" "$@"
        else
            echo "play: unknown command '$CMD'. Run 'play help' for usage." >&2
            exit 1
        fi
        ;;
esac
