<?xml version="1.0" encoding="UTF-8"?>

<project name="play! framework" default="jar" basedir="." xmlns:if="ant:if" xmlns:unless="ant:unless">

    <property name="baseversion" value="1.13.53" />
    <property name="build-release" value="25" />
    <!-- Loaded as a startup -javaagent in test forks so Mockito's inline mock-maker
         doesn't have to self-attach byte-buddy-agent at runtime (which JDK 21+ warns
         about and a future JDK will disallow). Bump in lock-step with byte-buddy-*.jar. -->
    <property name="bytebuddy.agent.jar" value="${basedir}/lib-test/byte-buddy-agent-1.18.10.jar" />

    <path id="project.classpath">
        <fileset dir=".">
            <include name="play-*.jar"/>
        </fileset>
        <fileset dir="lib">
            <include name="*.jar"/>
        </fileset>
    </path>

    <path id="classpath.test">
        <pathelement location="classes" />
        <pathelement location="test-classes" />
        <fileset dir="lib">
            <include name="*.jar"/>
        </fileset>
        <fileset dir="lib-test">
            <include name="*.jar"/>
        </fileset>
    </path>

    <!-- PF-164: the integration fixture mounts the docviewer module (see
         test-src/integration/testapp/modules/docviewer) so /@docs routing is covered by
         DocViewerFunctionalTest. Play.addModule puts a module's app/ on javaPath but does
         NOT put its lib/ jars on the classpath — that is the launcher's job — so
         play-docviewer.jar has to be added here explicitly. Without it the runtime-compiled
         controllers fail on play.modules.docviewer.DocumentationGenerator. Kept separate
         from classpath.test so plain unit tests can't accidentally depend on module classes. -->
    <path id="classpath.integration">
        <path refid="classpath.test" />
        <fileset dir="../modules/docviewer/lib" erroronmissingdir="false">
            <include name="*.jar"/>
        </fileset>
    </path>

    <target name="clean" description="clean resources">
        <delete dir="classes" />
        <delete dir="dist" />
        <delete dir="tests-results" />
        <delete dir="tests-tmp" />
        <delete file="src/play/version" />
        <delete includeemptydirs="true">
            <fileset dir=".">
                <include name="play-*.jar" />
            </fileset>
        </delete>
        <antcall target="clean-tests"/>
    </target>

    <target name="version" unless="version">
        <property name="version" value="${baseversion}" />
        <echo message="Version ${version}"></echo>
    </target>

    <target name="compile" description="compile without cleaning">
        <mkdir dir="classes"/>
        <javac encoding="utf-8" srcdir="src" destdir="classes" debug="true" release="${build-release}" includeantruntime="false">
            <classpath refid="project.classpath" />
        </javac>
        <copy todir="classes">
            <fileset dir="src">
                <include name="**/*.properties"/>
                <include name="**/*.xml"/>
                <include name="**/play.plugins"/>
                <!-- PF-88: Java ServiceLoader registrations (e.g. play.cache.CacheProvider) -->
                <include name="META-INF/services/**"/>
            </fileset>
        </copy>
    </target>

    <target name="javadoc" description="Generate the Javadoc" depends="version">
        <delete dir="../documentation/api" />
        <javadoc packagenames="play.*"
               sourcepath="src"
               defaultexcludes="yes"
               destdir="../documentation/api"
               author="false"
               version="true"
               use="true"
               windowtitle="Play! API"
               Encoding="UTF-8"
               docencoding="UTF-8"
               charset="UTF-8"
               >
            <classpath refid="project.classpath"/>
            <classpath refid="classpath.test"/>
            <doctitle><![CDATA[<h1>Play! ${version}</h1>]]></doctitle>
            <bottom><![CDATA[<a href="http://guillaume.bort.fr">Guillaume Bort</a> &amp; <a href="http://www.zenexity.fr">zenexity</a> - Distributed under <a href="http://www.apache.org/licenses/LICENSE-2.0.html">Apache 2 licence</a>, without any warrantly]]></bottom>
            <tag name="play.todo" scope="all" description="To do:"/>
        	  <tag name="todo" scope="all" description="To do:"/>
            <group title="Libs" packages="play.libs.*"/>
            <arg value="-Xdoclint:all,-missing"/>
            <!-- Every link is offline=true: an offline=false link makes javadoc fetch the
                 remote element-list at build time, so `ant package` succeeds or fails on a
                 third party's uptime. That is how the Hibernate link broke (Cloudflare 525),
                 and the commons-fileupload one before it (521). The href stays live so links
                 in the generated docs still resolve for readers; only the build-time fetch
                 goes away. Refresh a list with:
                   curl -L -o javadoc-package-lists/<dir>/element-list <href>element-list -->
            <link offline="true" href="https://docs.oracle.com/en/java/javase/25/docs/api/" packagelistLoc="javadoc-package-lists/jdk-25" />
            <link offline="true" href="https://javadoc.io/doc/commons-fileupload/commons-fileupload/1.6.0/" packagelistLoc="javadoc-package-lists/commons-fileupload-1.6.0" />
            <!-- No Hibernate link. It was pinned to 4.2 while the fork shipped 7.4.5 and nobody
                 noticed, because no play.* signature exposes a Hibernate type — it produced zero
                 cross-links either way. Re-add (offline, with a vendored element-list) only if
                 some public API starts returning one. The c3p0 link was dropped outright: c3p0
                 has not been a dependency since the move to HikariCP. -->
        </javadoc>
    </target>

    <target name="build" description="Build play">
        <antcall target="jar"/>
    </target>

    <target name="jar" depends="clean,version,compile,modules" description="create play.jar">
        <echo message="${version}" file="src/play/version" />
        <echo message="${version}" file="classes/play/version" />
        <echo message="build-release=${build-release}" />
        <jar destfile="play-${version}.jar" basedir="classes">
            <manifest>
                <attribute name="Premain-Class" value="play.classloading.HotswapAgent"/>
                <attribute name="Can-Redefine-Classes" value="true" />
                <section name="Play">
                    <attribute name="Specification-Title" value="Play! framework"/>
                    <attribute name="Specification-Version" value="${version}"/>
                    <attribute name="Specification-Vendor" value="zenexity"/>
                </section>
            </manifest>
        </jar>
    </target>

    <!-- PF-62: resolve framework deps from dependencies.yml via Ivy and populate
         framework/lib/ to match. Replaces the manual "curl from Maven Central +
         shasum verify + commit jars" flow. Idempotent. Run after editing
         framework/dependencies.yml. Pass -Dprune=true to delete jars in lib/
         that are no longer in the manifest; -Dverbose to see Ivy's resolution
         detail. lib/ stays committed — the target updates it in place so PR
         diffs still show jar adds/removes. -->
    <target name="resolve" depends="compile" description="Resolve framework deps from dependencies.yml via Ivy; updates framework/lib/ in place. -Dprune=true deletes strays.">
        <property name="prune" value="false"/>
        <property name="verbose" value="false"/>
        <java classname="play.deps.FrameworkResolve" fork="true" failonerror="true">
            <classpath>
                <pathelement location="classes"/>
                <fileset dir="lib">
                    <include name="*.jar"/>
                </fileset>
            </classpath>
            <sysproperty key="framework.path" value="${basedir}"/>
            <sysproperty key="play.version" value="${baseversion}"/>
            <sysproperty key="prune" value="${prune}"/>
            <sysproperty key="verbose" value="${verbose}"/>
        </java>
    </target>

    <target name="modules">
        <property name="play.path" value="../.."/>
        <property name="build-release" value="${build-release}"/>
        <ant antfile="build.xml" target="build" dir="../modules/testrunner" />
        <ant antfile="build.xml" target="build" dir="../modules/docviewer" />
    </target>

    <!-- Runs each module's `unittest` target. Modules without tests have a
         no-op `unittest` target so this can be called generically. Invoked
         by the framework's `unittest` target after framework JUnit tests
         have passed; new modules just need an `unittest` target in their
         build.xml to be picked up. -->
    <target name="module-unittest" depends="modules,compile-tests">
        <property name="play.path" value="../.."/>
        <ant antfile="build.xml" target="unittest" dir="../modules/testrunner" />
        <ant antfile="build.xml" target="unittest" dir="../modules/docviewer" />
    </target>

    <!-- Tests -->
    <!-- PF-79: depend on agent-jar so consumers (integration-test, test-single,
         unittest) that fork a JVM with -javaagent:play-${version}.jar
         get the jar built before the test JVM tries to load it. agent-jar already
         depends on version+compile, so the cascade does not double-compile.
         PF-80: also copies non-Java resource fixtures (.plugins, .yml, .properties,
         images) into test-classes so classpath lookups work under all test runners.
         Previously this copy was only in compile-unittest, which silently broke any
         resource-loading test invoked via test-single. -->
    <target name="compile-tests" depends="version,agent-jar,compile">
        <mkdir dir="test-classes"/>
        <javac encoding="utf-8" nowarn="${compile.nowarn}" debug="true"
               destdir="test-classes" classpathref="project.classpath" srcdir="test-src"
               release="${build-release}" includeantruntime="false">
            <classpath refid="classpath.test" />
            <include name="**/*.java"/>
        </javac>
        <copy todir="test-classes">
            <fileset dir="test-src">
                <include name="**/*.properties"/>
                <include name="**/*.sql"/>
                <include name="**/*.yml"/>
                <include name="**/*.xml"/>
                <include name="**/*.plugins"/>
                <include name="**/*.gif"/>
                <include name="**/*.png"/>
                <include name="**/*.jpg"/>
                <include name="**/IOTest/**"/>
            </fileset>
        </copy>
    </target>

    <!-- PF-164: depends on `modules` so ../modules/docviewer/lib/play-docviewer.jar exists
         before classpath.integration is resolved — the fixture mounts docviewer, and a bare
         `ant integration-test` from a clean tree would otherwise boot without it. -->
    <target name="integration-test" depends="compile-tests,version,modules">
        <mkdir dir="tests-results" />
        <junitlauncher haltonfailure="false" failureproperty="integration.failure" printSummary="true">
            <classpath refid="classpath.integration" />
            <testclasses>
                <fileset dir="test-classes" includes="integration/*Test.class" />
                <fork>
                    <jvmarg value="-javaagent:${basedir}/play-${version}.jar" />
                    <jvmarg value="-javaagent:${bytebuddy.agent.jar}" />
                    <jvmarg value="-DPLAY_SECRET=integrationtestsecretkey1234567890integrationtest" />
                    <!-- PF-57: Netty 4.2 QUIC + brotli4j use JNI; native-access flag below avoids
                         silent JNI restrictions on JDK 25 that the play CLI sets via deps.py. -->
                    <jvmarg value="--enable-native-access=ALL-UNNAMED" />
                    <!-- PF-134: forward -Dsse.bench to the fork so the SseLoadBenchTest load
                         harness runs only on demand (otherwise it aborts via assumeTrue and
                         normal `ant test` never executes it). Enable: ant integration-test -Dsse.bench=1 -->
                    <jvmarg value="-Dsse.bench=true" if:set="sse.bench" />
                </fork>
            </testclasses>
            <classpath>
                <pathelement location="test-classes"/>
                <path refid="classpath.integration"/>
            </classpath>
            <listener type="legacy-plain" sendSysOut="true" sendSysErr="true" outputdir="tests-results" />
        </junitlauncher>
        <fail if="integration.failure" message="Integration test(s) failed!"/>
    </target>

    <!-- Single ordered verification entrypoint: clean build, framework JUnit
         tests (fastest signal first), then real-Netty integration tests. -->
    <target name="test" depends="clean,jar" description="full verification: unit + integration tests">

        <echo message="Running unit tests" />
        <antcall target="unittest" />

        <echo message="Running integration tests" />
        <antcall target="integration-test" />

        <antcall target="test-success" />
    </target>

    <target name="test-success">
        <echo message="*****************" />
        <echo message="All tests passed !" />
        <echo message="*****************" />
    </target>

    <target name="test-single" depends="compile-tests" description="run a single test">
        <mkdir dir="tests-results" />
        <mkdir dir="${basedir}/tests-tmp" />
        <!-- Translate dotted FQN (e.g. play.mvc.RouterTest) to a slash path so the
             fileset 'includes' actually resolves to the .class file on disk. Without
             this, dots are treated as literal characters and the include matches no
             files, producing a 0-test run. -->
        <loadresource property="testclass.path">
            <propertyresource name="testclass"/>
            <filterchain>
                <tokenfilter>
                    <replacestring from="." to="/"/>
                </tokenfilter>
            </filterchain>
        </loadresource>
        <junitlauncher haltonfailure="false" failureproperty="junit.failure" printSummary="true">
            <classpath refid="classpath.test" />
            <testclasses>
                <fileset dir="test-classes" includes="${testclass.path}.class" />
                <fork>
                    <jvmarg value="-javaagent:${basedir}/play-${version}.jar" />
                    <jvmarg value="-javaagent:${bytebuddy.agent.jar}" />
                    <sysproperty key="tests-tmp" value="${basedir}/tests-tmp" />
                </fork>
            </testclasses>
            <listener type="legacy-xml" sendSysOut="true" sendSysErr="true" outputdir="tests-results" />
            <listener type="legacy-plain" sendSysOut="true" sendSysErr="true" outputdir="tests-results"/>
            <listener type="legacy-brief" sendSysOut="true" sendSysErr="true" outputdir="tests-results"  />
        </junitlauncher>
        <delete dir="${basedir}/tests-tmp" />
        <fail if="junit.failure" message="Single test failed. See reports!"/>
    </target>

    <target name="clean-tests">
        <delete dir="test-classes" />
    </target>

    <target name="agent-jar" depends="version,compile">
        <echo message="${version}" file="src/play/version" />
        <echo message="${version}" file="classes/play/version" />
        <jar destfile="play-${version}.jar" basedir="classes">
            <manifest>
                <attribute name="Premain-Class" value="play.classloading.HotswapAgent"/>
                <attribute name="Can-Redefine-Classes" value="true" />
            </manifest>
        </jar>
    </target>

    <target name="unittest" depends="version,compile-tests,modules">
        <mkdir dir="${basedir}/tests-tmp" />
        <junitlauncher haltonfailure="false" failureproperty="junit.failure" printSummary="true">
            <classpath refid="classpath.test" />
            <testclasses>
                <fileset dir="test-classes" includes="**/*Test.class" excludes="integration/*Test.class" />
                <fork>
                    <jvmarg value="-javaagent:${basedir}/play-${version}.jar" />
                    <jvmarg value="-javaagent:${bytebuddy.agent.jar}" />
                    <sysproperty key="tests-tmp" value="${basedir}/tests-tmp" />
                </fork>
            </testclasses>
            <classpath>
                <pathelement location="test-classes"/>
                <path refid="classpath.test"/>
            </classpath>
        </junitlauncher>
        <delete dir="${basedir}/tests-tmp" />

        <!-- Framework tests done; now run each module's tests. Done after framework
             tests so a module test failure doesn't skip framework feedback. -->
        <antcall target="module-unittest" />

        <fail if="junit.failure" message="Unit test(s) failed. See reports!"/>
    </target>

    <target name="package" depends="artifact">
        <!-- Pre-publish the gradle-plugin into a local Maven repo bundled in the
             distribution. Generated apps resolve `id("org.playframework.play1")`
             from this repo via pluginManagement.repositories, so they don't
             need to compile the plugin from source at the user's first run.
             That source-compile path (the old pluginManagement.includeBuild
             model) requires writing into $frameworkPath, which fails on
             read-only installs (e.g. /opt/play1 owned by root). -->
        <delete dir="${basedir}/gradle-plugin-repo" />
        <exec executable="${basedir}/../gradlew" dir="${basedir}/.." failonerror="true">
            <arg value=":gradle-plugin:publishAllPublicationsToFrameworkLocalRepository" />
            <arg value="-q" />
        </exec>
        <copy todir="dist/play-${version}/framework/gradle-plugin-repo">
            <fileset dir="${basedir}/gradle-plugin-repo" />
        </copy>
        <mkdir dir="dist" />
        <zip destfile="dist/play-${version}.zip" comment="Play! ${version}" update="false">
            <!-- play + gradlew need the executable bit on Unix; the default zipfileset
                 mode is 0644, which produces "Permission denied" on first run of
                 ./play or ./gradlew after unzip. -->
            <zipfileset prefix="play-${version}" dir="dist/play-${version}" includes="**/*" excludes="play,gradlew" />
            <zipfileset prefix="play-${version}" dir="dist/play-${version}" includes="play,gradlew" filemode="755" />
        </zip>
    </target>

    <target name="artifact" depends="clean,version,jar,javadoc">
        <mkdir dir="dist" />
        <mkdir dir="dist/play-${version}" />
        <copy todir="dist/play-${version}">
            <fileset dir=".." excludes=".github/**,**/cobertura.ser,**/*.pyc,**/*.log,hs_err*,.*,.*/*,build/**,framework/gradle-plugin/build/**,**/.gradle/**,**/.kotlin/**,framework/dist/**,framework/tailwindcss,framework/test-src/**,id,**/.bzr/**,**/.git/**,*.bzrignore,framework/classes/**,framework/tests-results/**,test-result/**,framework/test-result/**,docs/**,renovate.json5,modules/**,openspec/**,.claude/**,CLAUDE.md,sync-fork.sh,_bmad/**,_bmad-output/**,.agents/**,AGENTS.md" />
            <fileset dir=".." includes="modules/docviewer/**,modules/testrunner/**" excludes="**/*.pyc" />
        </copy>
    </target>

</project>
