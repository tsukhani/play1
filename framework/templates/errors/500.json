#{if play.mode.name() == 'DEV'}
{
    "type":    ${new com.google.gson.Gson().toJson(exception?.class?.name).raw()},
    "message": ${new com.google.gson.Gson().toJson(exception?.message).raw()}
}
#{/if}
#{else}
{
    "type":    "InternalServerError",
    "message": "An internal error occurred."#{if exception instanceof play.exceptions.PlayException},
    "id":      "${exception.id}"#{/if}

}
#{/else}
