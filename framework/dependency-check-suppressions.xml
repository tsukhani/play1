<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWASP dependency-check suppressions for the jars the Play release ships (PF-195).

  `ant dependency-check` scans with this file. The release zip carries it at
  framework/dependency-check-suppressions.xml, so that an application scanning framework/lib
  adds it to its own suppressionFiles (documentation/manual/dependency.textile). Every entry
  therefore has to hold wherever the framework is installed:

    - Match the jar by filePath, with [/\\] for each separator so that it also matches on
      Windows. A jar scanned from a directory has a package URL only if it embeds Maven
      metadata of its own, and many do not, so a packageUrl rule can match nothing.
    - Suppress by CVE where dependency-check names the right product but the CVE does not
      apply to this jar, and by CPE only where the product itself is wrong.
    - Say why in <notes>.

  Section A holds false positives and has no expiry. Section B holds risk accepts: vulnerable
  code that is present but not fixed yet. Each one has an `until` date, after which the scan
  fails again. A finding that a version bump fixes belongs in a bump, not here.
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!-- ==================================================================
         SECTION A - FALSE POSITIVES (no expiry)
         ================================================================== -->

    <suppress>
        <notes><![CDATA[
            Wrong product. io.micrometer:micrometer-registry-prometheus is Micrometer's
            Prometheus exposition registry. dependency-check matches it to
            cpe:/a:prometheus:prometheus, the Prometheus server, and compares Micrometer's 1.x
            version with the server's. CVE-2026-42154 (the server's /api/v1/read endpoint before
            3.5.3) and CVE-2019-3826 (server UI XSS before 2.7.1) are in code this jar does not
            contain, and so is anything else filed against the server.
        ]]></notes>
        <filePath regex="true">.*[/\\]framework[/\\]lib[/\\]micrometer-registry-prometheus-[^/\\]*\.jar$</filePath>
        <cpe>cpe:/a:prometheus:prometheus</cpe>
    </suppress>

    <suppress>
        <notes><![CDATA[
            Wrong product. gradle-plugin-<version>.jar is this fork's Play 1 Gradle plugin
            (org.playframework:gradle-plugin, versioned with the framework), which `ant package`
            publishes into framework/gradle-plugin-repo. dependency-check matches it to
            cpe:/a:gradle:gradle, Gradle itself, and compares the plugin's 1.13.x with Gradle's
            version ranges, which reports every Gradle CVE before 7.x. The jar holds the plugin's
            own classes and no Gradle code.
        ]]></notes>
        <filePath regex="true">.*[/\\]framework[/\\]gradle-plugin(-repo[/\\].*|[/\\]build[/\\]libs)[/\\]gradle-plugin-[^/\\]*\.jar$</filePath>
        <cpe>cpe:/a:gradle:gradle</cpe>
    </suppress>

    <!-- ==================================================================
         SECTION B - TIME-BOXED RISK ACCEPTS (expire and fail the scan again)
         ================================================================== -->

</suppressions>
